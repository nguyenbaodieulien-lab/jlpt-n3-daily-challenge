rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboards/{challengeId}/scores/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','score','correct','total','durationSeconds','submittedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 1000
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0 && request.resource.data.correct <= 20
        && request.resource.data.total == 20
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 900
        && request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }
  }
}
